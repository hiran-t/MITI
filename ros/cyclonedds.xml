<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cyclone DDS settings for receiving large messages (raw images, point clouds) from the robot.
  Used when RMW_IMPLEMENTATION=rmw_cyclonedds_cpp. A large receive buffer keeps bursts of
  image fragments from being dropped; on Linux also raise the kernel limit once:
    sudo sysctl -w net.core.rmem_max=16777216
  Pin <NetworkInterface name="..."/> if the machine has several networks (Wi-Fi + Docker).
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true" />
      </Interfaces>
      <AllowMulticast>default</AllowMulticast>
    </General>
    <Internal>
      <SocketReceiveBufferSize min="default" max="16MB" />
    </Internal>
  </Domain>
</CycloneDDS>
