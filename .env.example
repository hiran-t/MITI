# Copy to .env and adjust. Read by `docker compose`, `next build` and `next dev`.

# --- MITI -------------------------------------------------------------------------------------
# Where browsers find foxglove_bridge. Leave unset to use ws://<host MITI is served from>:8765,
# which is right when the bridge runs on the same machine (pixi run miti-bridge or the compose
# bridge profile). Set it when MITI should always open one robot, e.g.:
# NEXT_PUBLIC_BRIDGE_URL=ws://192.168.10.27:8765
# Built into the app: rebuild (docker compose up -d --build) after changing it.

# Port MITI is served on by docker compose
# MITI_PORT=3000

# --- foxglove_bridge on this machine (compose profile "bridge", pixi run bridge) --------------
# Start the bridge together with MITI on every `docker compose up`
# COMPOSE_PROFILES=bridge

# Must match the robot
# ROS_DISTRO=humble
# ROS_DOMAIN_ID=0
# rmw_fastrtps_cpp (ROS 2 default) or rmw_cyclonedds_cpp
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Jazzy: find the robot by IP instead of multicast, which Wi-Fi often drops
# ROS_STATIC_PEERS=192.168.10.27

# Offer only some topics, e.g. compressed images instead of raw ones
# BRIDGE_TOPIC_WHITELIST=['/tf.*','/joint_states','/rosout','/camera/.*/compressed','/livox/lidar']
# BRIDGE_PORT=8765
# BRIDGE_SEND_BUFFER_LIMIT=10000000
