# foxglove_bridge Configuration
# Default: ws://localhost:8765
# Change this to match the foxglove_bridge URL on your robot
NEXT_PUBLIC_BRIDGE_URL=ws://localhost:8765

# Examples:
# Local development
# NEXT_PUBLIC_BRIDGE_URL=ws://localhost:8765

# Remote robot
# NEXT_PUBLIC_BRIDGE_URL=ws://192.168.10.27:8765

# Docker container
# NEXT_PUBLIC_BRIDGE_URL=ws://foxglove-bridge:8765
