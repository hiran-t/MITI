# foxglove_bridge beside MITI, for `miti run --bridge` and the miti-bridge service
# (restart it after changes: sudo systemctl restart miti-bridge).
# See https://github.com/hiran-t/MITI/blob/main/docs/DEPLOYMENT.md#settings

# ROS 2 in /opt/ros to use; by default the one installed there.
#ROS_DISTRO=humble

# Must match the robot.
ROS_DOMAIN_ID=0
#RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# The robot's IPv4 addresses (a;b), for networks that drop multicast (Wi-Fi).
#ROS_STATIC_PEERS=192.168.10.27

# The port is BRIDGE_PORT in /etc/miti/miti.env.
#BRIDGE_TOPIC_WHITELIST=['/tf.*','/joint_states','/camera/.*/compressed']
