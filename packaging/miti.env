# MITI settings, read by `miti run` and the miti service (restart it after changes:
# sudo systemctl restart miti). Variables set in the shell win over these.

# Address and port MITI serves on; a taken port moves to the next free one.
MITI_HOST=0.0.0.0
MITI_PORT=3000

# Port of foxglove_bridge, on the machine MITI is opened from: browsers connect to
# ws://<that machine>:<port>. `miti run --bridge` and the miti-bridge service use it too.
BRIDGE_PORT=8765

# ROS package folders for robot meshes (package://) when foxglove_bridge does not serve them,
# separated by ":", e.g. a workspace's install folder.
#MITI_PACKAGE_PATH=/home/robot/ros2_ws/install

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
