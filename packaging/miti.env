# MITI settings, read by the miti service. Apply changes with: sudo systemctl restart miti

# Address and port MITI serves on.
HOSTNAME=0.0.0.0
PORT=3000

# Port of foxglove_bridge on the machine MITI is opened from (browsers connect to
# ws://<that machine>:<port>). Enter another address in MITI's connection settings.
MITI_BRIDGE_PORT=8765

# ROS package folders for robot meshes (package://) when foxglove_bridge does not serve them,
# separated by ":", e.g. a workspace's install folder.
#MITI_PACKAGE_PATH=/home/robot/ros2_ws/install

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
